@model LMS.WEB.Models.EmployeeDashboardViewModel
@{
    ViewData["Title"] = "Employee Dashboard";
    Layout = "~/Views/Shared/_LayoutLMS.cshtml";
}

<div class="container-fluid px-4 py-3">

    <!-- DASHBOARD HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Welcome back, @Model.EmployeeName</h2>
            <p class="text-muted mb-0">Track your leave balances, view submission statuses, and apply for time off.</p>
        </div>
        <div>
            <a asp-controller="Leave" asp-action="ApplyLeave" class="btn btn-primary shadow-sm">
                <i class="bi bi-calendar-plus me-1"></i> Apply for Leave
            </a>
        </div>
    </div>

    <!-- FEEDBACK ALERTS -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- METRICS CARDS -->
    <div class="row g-3 mb-4">
        <!-- Total Applied Leaves -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body d-flex align-items-center justify-content-between p-3">
                    <div>
                        <span class="text-muted fw-semibold small text-uppercase">Total Applied</span>
                        <h3 class="fw-bold my-1">@Model.TotalLeavesCount</h3>
                        <small class="text-muted">Total leave requests</small>
                    </div>
                    <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-circle fs-4">
                        <i class="bi bi-calendar-range-fill"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Pending Leaves -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body d-flex align-items-center justify-content-between p-3">
                    <div>
                        <span class="text-warning fw-semibold small text-uppercase">Pending Review</span>
                        <h3 class="fw-bold my-1 text-warning">@Model.PendingLeavesCount</h3>
                        <small class="text-muted">Awaiting admin review</small>
                    </div>
                    <div class="bg-warning bg-opacity-10 text-warning p-3 rounded-circle fs-4">
                        <i class="bi bi-hourglass-split"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Approved Leaves -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body d-flex align-items-center justify-content-between p-3">
                    <div>
                        <span class="text-success fw-semibold small text-uppercase">Approved Leaves</span>
                        <h3 class="fw-bold my-1 text-success">@Model.ApprovedLeavesCount</h3>
                        <small class="text-muted">Granted by admin</small>
                    </div>
                    <div class="bg-success bg-opacity-10 text-success p-3 rounded-circle fs-4">
                        <i class="bi bi-check-circle-fill"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Rejected Leaves -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body d-flex align-items-center justify-content-between p-3">
                    <div>
                        <span class="text-danger fw-semibold small text-uppercase">Rejected Leaves</span>
                        <h3 class="fw-bold my-1 text-danger">@Model.RejectedLeavesCount</h3>
                        <small class="text-muted">Declined requests</small>
                    </div>
                    <div class="bg-danger bg-opacity-10 text-danger p-3 rounded-circle fs-4">
                        <i class="bi bi-x-circle-fill"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- LEAVE HISTORY TABLE -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0">My Leave History</h5>
            <span class="badge bg-light text-dark border">Personal submissions</span>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Date Range</th>
                        <th>Duration</th>
                        <th>Reason</th>
                        <th>Submitted On</th>
                        <th>Status</th>
                        <th>Admin Remarks</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.MyLeaves != null && Model.MyLeaves.Any())
                    {
                        @foreach (var item in Model.MyLeaves)
                        {
                            var badgeClass = item.Status switch
                            {
                                "Approved" => "bg-success text-white",
                                "Rejected" => "bg-danger text-white",
                                _ => "bg-warning text-dark"
                            };

                            <tr>
                                <td>
                                    <strong>@item.FromDate.ToString("dd MMM yyyy")</strong> &ndash; <strong>@item.ToDate.ToString("dd MMM yyyy")</strong>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        @item.TotalDays @(item.TotalDays == 1 ? "day" : "days")
                                    </span>
                                </td>
                                <td style="max-width: 260px;">
                                    <span class="text-truncate d-inline-block w-100" title="@item.Reason">
                                        @item.Reason
                                    </span>
                                </td>
                                <td>
                                    <small class="text-muted">@item.CreatedOn.ToString("dd MMM yyyy, hh:mm tt")</small>
                                </td>
                                <td>
                                    <span class="badge @badgeClass px-2 py-1">@item.Status</span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.AdminRemarks))
                                    {
                                        <span class="text-dark small"><i class="bi bi-chat-left-text me-1 text-muted"></i>@item.AdminRemarks</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">&mdash;</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-calendar-x fs-2 d-block mb-2"></i>
                                You haven't submitted any leave requests yet.<br />
                                <a asp-controller="Leave" asp-action="ApplyLeave" class="btn btn-sm btn-outline-primary mt-2">
                                    Apply Now
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>
