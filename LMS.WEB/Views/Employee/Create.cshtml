@model LMS.WEB.Models.UserViewModel

@{
    ViewData["Title"] = "Create Employee";
    Layout = "~/Views/Shared/_LayoutLms.cshtml";
}

@using (Html.BeginForm("Create", "Employee", FormMethod.Post, new { @class = "form-horizontal" }))
{
    @Html.AntiForgeryToken()

    <section class="content">

        <div class="row justify-content-center">
            <div class="col-md-12">

                <div class="box box-info box_padding">

                    <div class="box-header with-border">
                        <h3 class="box-title">Create Employee</h3>
                    </div>

                    <div class="box-body">

                        @Html.ValidationSummary(
                            true,
                            "",
                            new { @class = "text-danger alert alert-danger" })

                        @Html.Partial("_UserForm", Model)

                    </div>

                </div>

            </div>
        </div>

    </section>
}
