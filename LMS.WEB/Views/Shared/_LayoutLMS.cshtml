<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LMS</title>

    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
   
    <link rel="stylesheet" href="~/css/lms.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/lms-forms.css" asp-append-version="true" />
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
</head>
<body class="sidebar-open">

    <!-- ================= SIDEBAR ================= -->
    <aside class="sidebar">
        <!-- Logo -->
        <div class="brand">
            <div class="brand-icon">
                <i class="bi bi-lightning-charge-fill"></i>
            </div>
            <span class="brand-text">
                LMS<span class="brand-highlight"></span>
            </span>
        </div>

        <!-- Main -->
        <div class="menu-title">MAIN</div>
        <nav class="sidebar-menu">
            @if (Context.Request.Cookies["UserRole"] == "Employee")
            {
                <a asp-controller="Employee" asp-action="Dashboard" class="menu-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Employee" ? "active" : "")">
                    <i class="bi bi-grid-1x2-fill"></i>
                    <span>Dashboard</span>
                </a>               
                <a asp-controller="Leave" asp-action="Index" class="menu-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Leave" ? "active" : "")">
                    <i class="bi bi-people-fill"></i>
                    <span>Leave</span>
                </a>
            }
            @if (Context.Request.Cookies["UserRole"] == "Admin")
            {
                <a asp-controller="Admin" asp-action="Dashboard" class="menu-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" ? "active" : "")">
                    <i class="bi bi-grid-1x2-fill"></i>
                    <span>Dashboard</span>
                </a>
                <a asp-controller="Employee" asp-action="Index" class="menu-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Employee" ? "active" : "")">
                    <i class="bi bi-people-fill"></i>
                    <span>Employees</span>
                </a>
               
            }
               
        </nav>

       

        <!-- Bottom -->
        <div class="sidebar-bottom">
            <a asp-controller="Account" asp-action="Logout" class="menu-item">
                <i class="bi bi-box-arrow-right"></i>
                <span>Logout</span>
            </a>
        </div>
    </aside>

    <!-- Optional: Backdrop overlay for mobile screens -->
    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <!-- ================= MAIN WRAPPER ================= -->
    <div class="main-wrapper">

        <!-- ================= TOPBAR ================= -->
        <header class="topbar">
            <div class="d-flex align-items-center gap-3">
                <!-- Sidebar Toggle Button -->
                <button type="button" class="sidebar-toggle-btn" id="sidebarToggle" aria-label="Toggle Navigation">
                    <i class="bi bi-list fs-4"></i>
                </button>

                <div class="search-box">
                    <i class="bi bi-search"></i>
                    <input type="text" placeholder="Search Employees..." />
                </div>
            </div>

            <div class="topbar-right">
                <!-- Notification -->
                <button class="icon-button">
                    <i class="bi bi-bell"></i>
                    <span class="notification-dot"></span>
                </button>

                <!-- Profile -->
                <div class="user-profile">
                    <div class="user-avatar">AD</div>
                    <div class="user-info">
                        <div class="user-name">@Context.Request.Cookies["UserName"]</div>
                        <div class="user-role" style="color:#000000!important">@Context.Request.Cookies["UserRole"]</div>
                    </div>
                    <i class="bi bi-chevron-down user-arrow"></i>
                </div>
            </div>
        </header>

        <!-- ================= PAGE CONTENT ================= -->
        <main class="page-content">
            @RenderBody()
        </main>
    </div>

    <!-- ================= SCRIPTS ================= -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- Sidebar Toggle Script -->
    <script>
            $(document).ready(function() {
                // Restore saved preference
                var isCollapsed = localStorage.getItem('gymflow_sidebar_collapsed') === 'true';
                if (isCollapsed) {
                    $('body').addClass('sidebar-collapsed').removeClass('sidebar-open');
                }

                // Click event for hamburger button & mobile overlay
                $('#sidebarToggle, #sidebarOverlay').on('click', function() {
                    $('body').toggleClass('sidebar-collapsed');

                    // Persist choice in browser localStorage
                    var currentlyCollapsed = $('body').hasClass('sidebar-collapsed');
                    localStorage.setItem('gymflow_sidebar_collapsed', currentlyCollapsed);
                });
            });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>